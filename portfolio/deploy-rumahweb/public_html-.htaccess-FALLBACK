RewriteEngine On
RewriteCond %{REQUEST_URI} !^/cms-deploy/

# Kalau file statis (JS/CSS/gambar) benar-benar ada di dalam cms-deploy/public/,
# sajikan langsung dari situ.
RewriteCond %{DOCUMENT_ROOT}/cms-deploy/public%{REQUEST_URI} -f
RewriteRule ^(.*)$ cms-deploy/public/$1 [L]

# Selain itu (semua route aplikasi, termasuk /kelola), teruskan langsung ke
# front controller Laravel — tidak mengandalkan .htaccess di dalam
# cms-deploy/public/ karena hosting ini tidak menurunkan proses rewrite
# ke situ (itu sebabnya versi sebelumnya cuma jalan di "/").
RewriteCond %{REQUEST_URI} !^/cms-deploy/
RewriteRule ^(.*)$ cms-deploy/public/index.php [L]
