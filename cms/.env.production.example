# Contoh .env untuk produksi (Rumahweb). JANGAN diisi nilai asli di sini —
# berkas ini cuma referensi bentuk; isi .env yang sebenarnya langsung di
# server lewat File Manager cPanel (lihat panduan deploy).

APP_NAME="Ajat Sudrajat"
APP_ENV=production
APP_KEY=
APP_DEBUG=false
APP_URL=https://ajatsudrajat.my.id

APP_LOCALE=id
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=id_ID
APP_TIMEZONE=Asia/Jakarta

LOG_CHANNEL=stack
LOG_LEVEL=error

DB_CONNECTION=mysql
DB_HOST=127.0.0.1
DB_PORT=3306
DB_DATABASE=isi_nama_database_cpanel
DB_USERNAME=isi_username_database_cpanel
DB_PASSWORD=isi_password_database_cpanel

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_SECURE_COOKIE=true
SESSION_DOMAIN=.ajatsudrajat.my.id

FILESYSTEM_DISK=local
QUEUE_CONNECTION=database
CACHE_STORE=database

MAIL_MAILER=log
